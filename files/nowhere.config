# Generate a key with "nowhere generate-key" and use it on all peers.
# NW3 requires exactly 32 lowercase hexadecimal characters.
config instance 'portal'
	option enabled '0'
	option url 'portal://REPLACE_WITH_GENERATED_KEY@*:2000'
	option user ''
	option group ''
	list env 'NOW_TRANSPORT_MEMORY_PROFILE=throughput'

config instance 'vector'
	option enabled '0'
	option url 'vector://REPLACE_WITH_GENERATED_KEY@127.0.0.1:2000?in=127.0.0.1:1080'
	option user ''
	option group ''
	list env 'NOW_TRANSPORT_MEMORY_PROFILE=throughput'

# The Portal must use out=egress and expose a QUIC listener.
# For generated Portal certificates, set a verified pin on Vector/Egress URLs.
config instance 'egress'
	option enabled '0'
	option url 'egress://REPLACE_WITH_GENERATED_KEY@127.0.0.1/udp:2000'
	option user ''
	option group ''
	list env 'NOW_TRANSPORT_MEMORY_PROFILE=throughput'
